<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_phone_specs" model="ir.ui.view">
        <field name="name">product.template.form.phone.specs</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="after">
                <page name="phone_specs" string="Phone specs">
                    <group>
                        <group>
                            <field name="is_phone"/>
                            <field name="phone_brand" invisible="not is_phone"/>
                            <field name="phone_model" invisible="not is_phone"/>
                            <field name="phone_os" invisible="not is_phone"/>
                            <field name="phone_chipset" invisible="not is_phone"/>
                            <field name="phone_ram_gb" invisible="not is_phone"/>
                            <field name="phone_storage_gb" invisible="not is_phone"/>
                            <field name="phone_release_year" invisible="not is_phone"/>
                        </group>
                        <group invisible="not is_phone">
                            <field name="phone_screen_inch"/>
                            <field name="phone_refresh_rate_hz"/>
                            <field name="phone_battery_mah"/>
                            <field name="phone_charging_w"/>
                            <field name="phone_main_camera_mp"/>
                            <field name="phone_weight_g"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
