<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_chat" model="ir.ui.view">
        <field name="name">sale.order.form.chat</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="chat_session_id" invisible="not chat_session_id"/>
                <field name="chat_shortage" invisible="not chat_shortage"/>
            </xpath>
        </field>
    </record>
</odoo>
