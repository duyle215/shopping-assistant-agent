# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=shopping_assistant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password

# OpenAI
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxx
LLM_MODEL=gpt-4.1-mini
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536

# Agent Loop (mac dinh dung chung OPENAI_BASE_URL / OPENAI_API_KEY)
# Chi can set neu muon dung provider khac:
# AGENT_LOOP_BASE_URL=https://api.openai.com/v1
# AGENT_LOOP_API_KEY=sk-proj-xxx

# Qdrant
QDRANT_PATH=./qdrant_data
QDRANT_COLLECTION=product_knowledge
