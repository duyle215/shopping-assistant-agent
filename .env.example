# PostgreSQL of the agent (conversation checkpoints, traces). The same container hosts Odoo's database.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=shopping_assistant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password

# Odoo 19 (products, stock, orders, CRM). `docker compose run --rm odoo-setup` creates the
# API users and writes their keys to odoo/secrets/<db>.json, which the app reads by default.
ODOO_DB_PASSWORD=your_odoo_db_password
ODOO_URL=http://localhost:8069
ODOO_DB=odoo
# ODOO_API_KEY=...            # instead of odoo/secrets/<db>.json
# Chat page URL as seen by website visitors (the floating chat button on the Odoo website)
# CHAT_APP_URL=http://localhost:5000
# Tests and the agent evaluation use the odoo_test / odoo_eval databases on the same server:
#   ODOO_DB_FILTER=^odoo docker compose up -d odoo

# LLM provider (any OpenAI-compatible endpoint)
# --- Option A: OpenAI ---
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxx
LLM_MODEL=gpt-4.1-mini
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536

# --- Option B: Google Gemini (free tier works) ---
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_API_KEY=your_gemini_api_key
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_FALLBACK_MODEL=gemini-3.5-flash
# EMBED_MODEL=gemini-embedding-001
# EMBED_DIM=3072

# Optional second input guardrail: an LLM classifies prompt injection (one extra call per message)
# GUARD_MODEL=gemini-3.5-flash-lite

# Fallback when LLM_MODEL hits its quota. Free-tier limits are per model and differ a lot
# (when tested: 500 requests/day for gemini-3.5-flash-lite, 20/day for gemini-3.5-flash).
# LLM_FALLBACK_MODEL=gemini-3.5-flash

# Model for scripts/extract_catalog.py (defaults to LLM_MODEL)
# EXTRACT_MODEL=gemini-3.5-flash-lite

# Agent loop (defaults to OPENAI_BASE_URL / OPENAI_API_KEY)
# Only set these to use a different provider for the agent loop:
# AGENT_LOOP_BASE_URL=https://api.openai.com/v1
# AGENT_LOOP_API_KEY=sk-proj-xxx

# Qdrant: local file mode by default; set QDRANT_URL to use a Qdrant server
QDRANT_PATH=./qdrant_data
# QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=product_knowledge

# Flask
FLASK_DEBUG=false
