# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=shopping_assistant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password

# Ollama (dung cho local fallback neu can)
OLLAMA_URL=http://localhost:11434

# OpenAI
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxx
LLM_MODEL=gpt-4.1-mini
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536

# Agent - Intent parsing (Ollama local - nhe, nhanh)
AGENT_BASE_URL=http://localhost:11434/v1
AGENT_API_KEY=ollama
INTENT_MODEL=qwen2.5:3b

# Agent - Synthesis (dung OpenAI cho chat luong tra loi tot hon)
SYNTHESIS_MODEL=gpt-4.1-mini

# Qdrant
QDRANT_PATH=./qdrant_data
QDRANT_COLLECTION=product_knowledge
